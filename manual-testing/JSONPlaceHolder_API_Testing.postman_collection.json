    {
      "name": "End-to-End (E2E) Persistence Flow",
      "item": [
        {
          "name": "TC-06_Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "if (response.id) {\r",
                  "    pm.environment.set(\"newId\", response.id);\r",
                  "    console.log(\"ID capturado y guardado: \" + response.id);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"title\": \"Postman E2E Test\",\r\n    \"body\": \"Checking variable persistence\",\r\n    \"userId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC-07_Create_Empty",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Confirm 404 due to mock statelessness\", function () {\r",
                  "    pm.response.to.have.status(404);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Verify requested ID matches\", function () {\r",
                  "    const requestedId = pm.environment.get(\"newId\");\r",
                  "    pm.expect(requestedId).to.eql(101);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{newId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{newId}}"
              ]
            }
          },
